# Strapi CMS (copy to .env or .env.local; .env.local overrides .env)
STRAPI_API_URL=https://your-strapi.example.com/api
STRAPI_API_TOKEN=

# This site's domain as configured in Strapi (site filter)
SITE_DOMAIN=ph646main.com
SITE_BASE_URL=https://ph646main.com
PUBLIC_SITE_ORIGIN=https://ph646main.com

POSTS_COLLECTION=posts
BLOG_BASE_PATH=blog

# Optional: override filter param name (empty = filters[site][domain][$eq])
# POSTS_SITE_FILTER_KEY=

# Local only — never set in CI
# SKIP_POSTS_SITE_FILTER=1

# CI sets SYNC_REQUIRE_SITE_FILTER=1 to fail if site filter is missing
# SYNC_REQUIRE_SITE_FILTER=1
